generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  STARTING
  HEALTHCHECKING
  RUNNING
  FAILED
  STOPPED
}

enum ApplicationType {
  DOCKERFILE
  NODE
  PYTHON
}

enum RoutingOperation {
  PROMOTE
  ABORT
  RETIRE
  STOP
  RESTART
  DELETE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id                String                  @id @default(uuid()) @db.Uuid
  hostnameLabel     String                  @unique @db.VarChar(36)
  userId            String                  @db.Uuid
  name              String                  @db.VarChar(100)
  repositoryUrl     String
  branch            String                  @db.VarChar(255)
  containerPort     Int
  healthCheckPath   String                  @default("/") @db.VarChar(1024)
  operationLockToken String?                @db.Uuid
  operationLockExpiresAt DateTime?
  activeDeploymentId String?               @db.Uuid
  routingOperation   RoutingOperation?
  routingDeploymentId String?              @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments       Deployment[]
  activeDeployment  Deployment?             @relation("ActiveDeployment", fields: [id, activeDeploymentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  routingDeployment Deployment?             @relation("RoutingDeployment", fields: [id, routingDeploymentId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  webhookDeliveries GitHubWebhookDelivery[]

  @@index([userId])
  @@index([operationLockExpiresAt])
}

model GitHubWebhookDelivery {
  deliveryId String   @id @db.VarChar(255)
  projectId  String   @db.Uuid
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model Deployment {
  id                         String           @id @default(uuid()) @db.Uuid
  projectId                  String           @db.Uuid
  rollbackSourceDeploymentId String?          @db.Uuid
  applicationType            ApplicationType?
  commitHash                 String?          @db.VarChar(64)
  status                     DeploymentStatus @default(QUEUED)
  containerId                String?
  imageId                    String?
  imageTag                   String?
  hostPort                   Int?
  errorMessage               String?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  project                    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rollbackSource             Deployment?      @relation("DeploymentRollbacks", fields: [rollbackSourceDeploymentId], references: [id], onDelete: SetNull)
  rollbacks                  Deployment[]     @relation("DeploymentRollbacks")
  activeFor                  Project[]        @relation("ActiveDeployment")
  routingFor                 Project[]        @relation("RoutingDeployment")

  @@unique([projectId, id])
  @@index([projectId])
  @@index([status])
  @@index([rollbackSourceDeploymentId])
}
