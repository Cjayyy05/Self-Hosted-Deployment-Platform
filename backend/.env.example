NODE_ENV=development
PORT=4000
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://deployflow:change-me@localhost:5432/deployflow?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
REGISTRATION_ENABLED=false
GITHUB_WEBHOOK_SECRET_KEY=replace-with-a-different-32-character-random-secret
PUBLIC_BASE_URL=http://localhost:4000
APP_HOSTING_ORIGIN=http://localhost:8080
APP_HOSTNAME_SUFFIX=localhost
# Optional absolute filesystem path to a private Caddy Unix socket
CADDY_ADMIN_SOCKET=
# Linux public mode uses the existing operator's user UUID.
# APP_PUBLIC_HOSTING_ENABLED=true
# APP_PUBLIC_OPERATOR_ID=
# Shared IPv4 DNS reference for public projects. Defaults to APP_HOSTNAME_SUFFIX.
# APP_PUBLIC_DNS_TARGET=dpflw-demo.dynv6.net
# Legacy approval import only. New projects use PostgreSQL approvals.
# APP_PUBLIC_PROJECT_ID=
# Record the Linux boot ID with every previous writer offline, before rebooting for the first public startup.
# APP_PUBLIC_PRE_CUTOVER_BOOT_ID=
