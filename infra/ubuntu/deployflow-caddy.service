[Unit]
Description=DeployFlow Caddy
Wants=network-online.target
After=network-online.target systemd-tmpfiles-setup.service
RequiresMountsFor=/srv/deployflow
ConditionPathIsMountPoint=/srv/deployflow

[Service]
User=caddy
Group=caddy
SupplementaryGroups=deployflow-caddy
Environment=XDG_DATA_HOME=/srv/deployflow/caddy
UMask=0077
ExecStartPre=/usr/bin/caddy validate --config /etc/deployflow/caddy.json
ExecStart=/usr/bin/caddy run --config /etc/deployflow/caddy.json
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/deployflow-caddy /srv/deployflow/caddy

[Install]
WantedBy=multi-user.target
