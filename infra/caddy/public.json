{
  "admin": {
    "listen": "unix//run/deployflow-caddy/admin.sock|0660",
    "config": { "persist": false }
  },
  "apps": {
    "tls": {
      "certificates": { "automate": ["APPROVED_HOSTNAME"] }
    },
    "http": {
      "servers": {
        "deployflow": {
          "listen": [":443"],
          "protocols": ["h1", "h2"],
          "strict_sni_host": true,
          "tls_connection_policies": [{}],
          "automatic_https": { "disable_redirects": true },
          "routes": [
            {
              "handle": [{ "handler": "static_response", "status_code": 404, "body": "Unknown host" }],
              "terminal": true
            }
          ]
        },
        "redirect": {
          "listen": [":80"],
          "protocols": ["h1"],
          "automatic_https": { "disable": true },
          "routes": [
            {
              "match": [{ "host": ["APPROVED_HOSTNAME"] }],
              "handle": [{
                "handler": "static_response",
                "status_code": 308,
                "headers": { "Location": ["https://APPROVED_HOSTNAME{http.request.uri}"] }
              }],
              "terminal": true
            },
            {
              "handle": [{ "handler": "static_response", "status_code": 404, "body": "Unknown host" }],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
